---
import { Icon } from 'astro-icon/components';
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewShowcase from '../components/ReviewShowcase';
import FillerContent from '../components/FillerContent.astro';
import TarotBoard from 'velvet-tarocchi';

const githubUsername = 'supersweet-dev';
const linkedinUsername = 'supersweet';
const instagramUsername = 'gem.ki.du';
const email = 'gema.ap97@gmail.com';
const mailto = `mailto:${email}`;
const resumeLink =
	'https://github.com/supersweet-dev/supersweet-dev.github.io/blob/main/resume.pdf';
---

<BaseLayout>
	<main>
		<!-- Centered header -->
		<!-- Static Header -->
		<div class="header-static">
			<p class="title">supersweet</p>
			<p class="bio">
				Jaime Alvarez : Full-Stack Developer & Visual Artist
			</p>
		</div>

		<!-- Sticky Social Bar -->
		<div class="sticky-social-bar">
			<div class="social-links">
				<a href={mailto} aria-label="Email"
					><Icon name="mdi:email-outline" class="social-icon" /></a
				>
				<a
					href={`https://github.com/${githubUsername}`}
					target="_blank"
					aria-label="GitHub"
					><Icon name="simple-icons:github" class="social-icon" /></a
				>
				<a
					href={`https://www.linkedin.com/in/${linkedinUsername}`}
					target="_blank"
					aria-label="LinkedIn"
					><Icon
						name="simple-icons:linkedin"
						class="social-icon"
					/></a
				>
				<a
					href={`https://www.instagram.com/${instagramUsername}`}
					target="_blank"
					aria-label="Instagram"
					><Icon
						name="simple-icons:instagram"
						class="social-icon"
					/></a
				>
				<a href={resumeLink} target="_blank" aria-label="Resume"
					><Icon
						name="mdi:file-document-outline"
						class="social-icon"
					/></a
				>
			</div>
		</div>
		<!-- Content -->
		<div class="content">
			<p>This is my personal space. Here I showcase some of my demos.</p>
			<p>
				Feel free to check out my resume, or connect with me on social
				media. Currently building out this site.
			</p>
			<p>
				The following reviews are fetched from my Letterboxd RSS feed,
				the posters come from the TMDB API, and this data is fetched
				using an edge function on refresh.
			</p>
			<ReviewShowcase
				apiUrl={new URL('/api/reviews', Astro.url)}
				client:load
			>
				<div slot="fallback"><h1>LOADING...</h1></div>
			</ReviewShowcase>
			<p>
				This is a micro-app that I built a few years ago as a JQuery
				demo to secure my first internship. It is a tarot board that
				uses your birthday to seed the shuffle, to put a little of you
				in it. I wrote each card's placement interpretation. This
				current version is a React component that you can grab from <a
					href="https://www.npmjs.com/package/velvet-tarocchi">npm</a
				>.
			</p>
			<TarotBoard client:only="react" />
		</div>
		<footer class="footer">
			© 2025 Gema Alvarez — Built with <a
				href="https://astro.build/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Astro<Icon name="simple-icons:astro" class="footer-icon" /></a
			>
		</footer>
	</main>
</BaseLayout>
